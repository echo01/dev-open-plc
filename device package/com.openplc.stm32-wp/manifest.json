{
    "formatVersion":  "1.0",
    "package":  {
                    "id":  "com.openplc.stm32-wp",
                    "name":  "STM32 WP boards",
                    "version":  "0.1.0",
                    "vendor":  {
                                   "name":  "OpenPLC WP",
                                   "url":  "https://openplcproject.com",
                                   "logo":  "assets/logo.png"
                               },
                    "description":  "OpenPLC HAL support for custom STM32 WP board profiles, including STM32G071RB and NUCLEO-H563ZI variants.",
                    "license":  "GPL-3.0",
                    "minEditorVersion":  "4.1.4",
                    "inDevelopment":  true
                },
    "devices":  [
                    {
                        "id":  "stm32g071rb-wp",
                        "name":  "STM32G071RB WP",
                        "category":  "Custom STM32 Board",
                        "preview":  "assets/boards/stm32g071rb-wp.png",
                        "target":  {
                                       "type":  "arduino-cli",
                                       "core":  "STMicroelectronics:stm32",
                                       "platform":  "STMicroelectronics:stm32:Nucleo_64:pnum=NUCLEO_G071RB",
                                       "boardManagerUrl":  "https://github.com/stm32duino/BoardManagerFiles/raw/main/package_stmicroelectronics_index.json"
                                   },
                        "specs":  {
                                      "CPU":  "STM32G071RB ARM Cortex-M0+ at 64MHz",
                                      "RAM":  "36 KB",
                                      "Flash":  "128 KB",
                                      "Analog Inputs":  "PA0, PA1, PA4, PA6, PA7",
                                      "Digital Inputs":  "PB8, PB2, PB3, PB4, PB5, PB9, PB10",
                                      "Digital Outputs":  "PB12, PB13, PB14, PB15, PC13, PC14, PC15",
                                      "USART2 Debug":  "PA2 TX, PA3 RX via ST-LINK",
                                      "USART1 Modbus RTU":  "PC4 TX, PC5 RX",
                                      "I2C1":  "SDA PA10, SCL PA9",
                                      "SPI1":  "MOSI PA12, MISO PA11, SCK PD8, CS PD9",
                                      "WiFi":  "No",
                                      "Bluetooth":  "No",
                                      "Ethernet":  "No"
                                  },
                        "hal":  {
                                    "type":  "arduino-hal",
                                    "source":  "hal/arduino/stm32_g071rb_wp.cpp",
                                    "compilerFlags":  {
                                                          "c_flags":  [
                                                                          "-MMD",
                                                                          "-c",
                                                                          "-Wno-incompatible-pointer-types"
                                                                      ],
                                                          "cxx_flags":  [
                                                                            "-fexceptions"
                                                                        ]
                                                      },
                                    "define":  [
                                                   "WP_STM32G071RB",
                                                   "WP_DEBUG_USART Serial",
                                                   "WP_MODBUS_RTU_USART Serial1",
                                                   "WP_I2C_SDA PA10",
                                                   "WP_I2C_SCL PA9",
                                                   "WP_SPI_MOSI PA12",
                                                   "WP_SPI_MISO PA11",
                                                   "WP_SPI_SCK PD8",
                                                   "WP_SPI_CS PD9"
                                               ]
                                },
                        "defaults":  {
                                         "pins":  {
                                                      "defaultDin":  [
                                                                         "PB8",
                                                                         "PB2",
                                                                         "PB3",
                                                                         "PB4",
                                                                         "PB5",
                                                                         "PB9",
                                                                         "PB10"
                                                                     ],
                                                      "defaultDout":  [
                                                                          "PB12",
                                                                          "PB13",
                                                                          "PB14",
                                                                          "PB15",
                                                                          "PC13",
                                                                          "PC14",
                                                                          "PC15"
                                                                      ],
                                                      "defaultAin":  [
                                                                         "PA0",
                                                                         "PA1",
                                                                         "PA4",
                                                                         "PA6",
                                                                         "PA7"
                                                                     ],
                                                      "defaultAout":  [

                                                                      ]
                                                  }
                                     },
                        "screens":  {
                                        "Modbus":  "screens/modbus.json"
                                    },
                        "debug":  {
                                      "channels":  [
                                                       {
                                                           "label":  "Modbus RTU on USART1",
                                                           "channel":  "rtu",
                                                           "enabledWhen":  {
                                                                               "$ref":  "screens.modbus_rtu.enabled"
                                                                           },
                                                           "params":  {
                                                                          "port":  {
                                                                                       "$ref":  "configuration.communicationPort",
                                                                                       "required":  "No serial port selected. Select the USB/serial adapter connected to USART1 Modbus RTU."
                                                                                   },
                                                                          "baudRate":  {
                                                                                           "$ref":  "screens.modbus_rtu.rtu_baud_rate",
                                                                                           "default":  "115200",
                                                                                           "as":  "number"
                                                                                       },
                                                                          "slaveId":  {
                                                                                          "$ref":  "screens.modbus_rtu.rtu_slave_id",
                                                                                          "default":  1,
                                                                                          "as":  "number"
                                                                                      }
                                                                      }
                                                       }
                                                   ],
                                      "messages":  {
                                                       "noneEnabled":  {
                                                                           "title":  "Modbus RTU Required",
                                                                           "body":  "Enable Modbus RTU in the Modbus screen to debug this board over USART1."
                                                                       }
                                                   }
                                  }
                    },
